{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monoco-admin",
  "compatibility_date": "2026-07-23",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "admin.monococollective.com/*",
      "zone_name": "monococollective.com"
    }
  ]
}
